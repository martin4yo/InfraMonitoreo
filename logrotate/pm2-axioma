    daily
    maxsize 200M
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 640 alveraapp alveraapp
}

# 🔴 mini: SOLO /var/log/mini. Los otros dos caminos de log de mini estan EXCLUIDOS a
# proposito y NO deben rotarse hasta que se roten las credenciales expuestas (S18):
#   /home/miniapp/.pm2/logs/*.log  -> mini-backend-out-0.log tiene contrasenias de
#       usuarios finales, whatsappApiKey y smtpPass en claro (3 console.log de la app).
#       El archivo ES la evidencia del alcance de la exposicion.
#   /var/www/mini/logs/*.log       -> combined.log: 1129 coincidencias de "token" y 3 de
#       "password" en una muestra de 5 MB (verificado 2026-09-16).
# Ver logrotate/README.md "Pendiente - mini en axioma" y hardening.md §9.
/var/log/mini/*.log {
    su miniapp miniapp
    daily
    maxsize 200M
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 640 miniapp miniapp
}

