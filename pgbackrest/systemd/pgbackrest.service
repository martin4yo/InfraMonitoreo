# Servicio del servidor TLS de pgBackRest.
# Destino: /etc/systemd/system/pgbackrest.service  (en TODOS los servers: repo y db hosts)
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pgbackrest
#
# Corre como el usuario 'postgres'. Escucha en el puerto tls-server-port (8432)
# según /etc/pgbackrest/pgbackrest.conf.

[Unit]
Description=pgBackRest TLS Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=postgres
Group=postgres
ExecStart=/usr/bin/pgbackrest server
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
