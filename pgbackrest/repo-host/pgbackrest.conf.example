# pgBackRest — config del REPO HOST (dev-1), que aloja los backups de todos.
# Destino: /etc/pgbackrest/pgbackrest.conf   (dueño pgbackrest:pgbackrest, chmod 640)
# El directorio /etc/pgbackrest debe ser traversable por postgres (chmod 755) para que
# el caso loopback de dev-1 pueda leer db.conf.
#
# Hay un [stanza] por cluster. Reemplazá <IP-dbhost> y <PG_PATH_*>.

[global]
repo1-path=/backup/pgbackrest
repo1-retention-full=4
repo1-retention-diff=7
compress-type=lz4
log-level-console=info
log-level-file=detail

# --- Stanza remota por SSH (un bloque por db host de producción) ---
[<stanza>]
pg1-host=<IP-dbhost>
pg1-host-user=postgres
pg1-path=<PG_PATH>
pg1-port=5432
# Para un db host con SSH en puerto != 22 (ej. clubix:2222) NO va acá: se resuelve en
# ~pgbackrest/.ssh/config con  Host <IP> / Port <puerto> / User postgres

# --- Stanza local de dev-1 (repo host = db host) vía SSH loopback ---
# pg1-host-config apunta a un config legible por postgres (db.conf.example).
[dev-1]
pg1-host=127.0.0.1
pg1-host-user=postgres
pg1-host-config=/etc/pgbackrest/db.conf
pg1-path=/var/lib/postgresql/14/main
pg1-port=5432
