# pgBackRest — config de un DB HOST (cliente del repo central por SSH).
# Destino: /etc/pgbackrest/pgbackrest.conf   (dueño postgres:postgres, chmod 640)
#
# Reemplazá:
#   <IP-dev-1>   IP del repo host (dev-1)
#   <stanza>     nombre de la stanza = nombre del server (debe coincidir en el repo)
#   <PG_PATH>    data dir de PostgreSQL en ESTE server (show data_directory;)
#
# Requisitos en el server: /var/spool/pgbackrest y /var/log/pgbackrest (dueño postgres),
# y confianza SSH postgres@este-host ↔ pgbackrest@dev-1 (ver docs/pgbackrest-setup.md).

[global]
repo1-host=<IP-dev-1>
repo1-host-user=pgbackrest
repo1-path=/backup/pgbackrest
repo1-retention-full=4
repo1-retention-diff=7
compress-type=lz4
compress-level=3
process-max=2
archive-async=y
spool-path=/var/spool/pgbackrest
start-fast=y
log-level-console=info
log-level-file=detail

[<stanza>]
pg1-path=<PG_PATH>
pg1-port=5432
